# Worker PROCESS image (the Redis-polling, Docker-spawning daemon).
#
# NOT to be confused with worker/Dockerfile, which builds the
# `gridforge-exec:latest` SANDBOX image that this process spawns
# per-task via the Docker SDK - that one never runs as a long-lived
# service, see docker-compose.yml's `gridforge-exec-image` service.
#
# Build context is the REPO ROOT, same reasoning as backend/Dockerfile.
# worker/main.py uses *unqualified* imports (`from config import
# settings`), so it must run with worker/ itself as the working
# directory, not as a `worker.*` package.
FROM python:3.11-slim

WORKDIR /app
COPY worker/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# gosu: lets the entrypoint drop from root to appuser cleanly (exec's
# directly, preserves environment/signal handling) after granting socket
# group access - see docker-entrypoint.sh for the full explanation of why
# this process starts as root at all.
RUN apt-get update \
    && apt-get install -y --no-install-recommends gosu \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd -r appuser \
    && useradd -r -g appuser -d /home/appuser -s /sbin/nologin -c "Application User" appuser

COPY shared/ /app/shared/
COPY worker/ /app/worker/
COPY worker/docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh
RUN chmod +x /usr/local/bin/docker-entrypoint.sh
WORKDIR /app/worker

ENTRYPOINT ["/usr/local/bin/docker-entrypoint.sh"]
CMD ["python", "main.py"]
