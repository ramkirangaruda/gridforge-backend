# Copy this to .env and fill in the values. Used by docker-compose.yml
# (and, for local non-Docker runs, by backend/core/config.py and
# worker/config.py directly).

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# --- Backend ---
API_PORT=8000
# "development" (default) is the only value that allows FRONTEND_URL to be
# left unset - anything else and the backend refuses to start without it,
# rather than silently falling back to wildcard CORS. docker-compose.prod.yml
# sets this to "production" for you; only needed here for non-Docker local
# runs where you want to test the strict behavior.
ENVIRONMENT=development
# Origin(s) allowed to call the API (CORS). Comma-separated if more than
# one (e.g. a custom domain plus a Vercel preview URL). In production this
# should be the frontend's real HTTPS origin, never localhost.
FRONTEND_URL=http://localhost:3000

# --- Production only (docker-compose.prod.yml) ---
# Hostname pointing at this VM - Caddy requests a Let's Encrypt cert for it.
DOMAIN=

# --- Auth ---
# Signs/verifies user JWTs. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
# Shared secret the worker presents when POSTing task updates. Must be the
# SAME value in both the backend's and the worker's environment.
WORKER_API_KEY=change-me

# --- Compose-only: uploads directory path mirroring ---
# REQUIRED for `docker compose up`. Must be the absolute path of this
# repo's ./uploads directory ON THE HOST - not a container path. The
# worker container mounts this path at the *same* location inside
# itself so that when it asks the host Docker daemon to bind-mount a
# task's extracted files into a sandbox container, the path it hands
# over actually resolves on the host. See docker-compose.yml for details.
#
# Linux/macOS example:
#   HOST_UPLOADS_DIR=/home/you/gridforge/uploads
# Windows + Docker Desktop example:
#   HOST_UPLOADS_DIR=C:/Users/you/gridforge/uploads
HOST_UPLOADS_DIR=
