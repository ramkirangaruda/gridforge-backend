.venv/

# Secrets - never commit real env files, only .env.example templates
.env
.env.local
.env.*.local

# Python
__pycache__/
*.pyc
.ruff_cache/
.pytest_cache/

# Backend runtime task file
backend/gridforge_task_run.py
backend/gridforge_task_run*.py

# Logs - anywhere in the repo, not just one path
*.log

# Uploaded projects and the SQLite task DB - anywhere under uploads/, not
# just the specific filenames seen so far. .gitkeep is the one file in
# here that's actually meant to be tracked, to keep the empty dir in git.
uploads/*
!uploads/.gitkeep

# node_modules - bare pattern (no leading path) matches at any depth, so
# this covers frontend/node_modules/ AND a stray root-level one alike.
node_modules/
build/
